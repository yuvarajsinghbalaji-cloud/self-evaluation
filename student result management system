// Generate class topper details
void generate_topper(int client_sock, const char *ip, int port) {
    FILE *fp = fopen(DB_FILE, "r");
    if (!fp) {
        send(client_sock, "ERROR: No records found.", 24, 0);
        return;
    }

    Student s, topper;
    float max_cgpa = -1.0;
    int found = 0;

    while (fscanf(fp, "%d %s %s %d %f %s %f", &s.reg_no, s.name, s.dept, &s.semester, &s.marks, s.grade, &s.cgpa) != EOF) {
        if (s.cgpa > max_cgpa) {
            max_cgpa = s.cgpa;
            topper = s;
            found = 1;
        }
    }
    fclose(fp);

    if (found) {
        char response[BUFFER_SIZE];
        snprintf(response, sizeof(response),
                 "--- Class Topper Details ---\nReg No: %d\nName: %s\nDept: %s\nSemester: %d\nMarks: %.2f\nGrade: %s\nCGPA: %.2f",
                 topper.reg_no, topper.name, topper.dept, topper.semester, topper.marks, topper.grade, topper.cgpa);
        send(client_sock, response, strlen(response), 0);
        log_transaction(ip, port, "TOPPER: Calculated class topper");
    } else {
        send(client_sock, "ERROR: No records available.", 28, 0);
    }
}

void handle_client(int client_sock, struct sockaddr_in client_addr) {
    char buffer[BUFFER_SIZE];
    char ip_str[INET_ADDRSTRLEN];
    inet_ntop(AF_INET, &(client_addr.sin_addr), ip_str, INET_ADDRSTRLEN);
    int port = ntohs(client_addr.sin_port);

    log_transaction(ip_str, port, "Client connected");

    while (1) {
        memset(buffer, 0, BUFFER_SIZE);
        int bytes_read = recv(client_sock, buffer, sizeof(buffer) - 1, 0);
        if (bytes_read <= 0) break;

        buffer[strcspn(buffer, "\n")] = 0;

        if (strncmp(buffer, "ADD", 3) == 0) {
            Student s;
            sscanf(buffer + 4, "%d %s %s %d %f %s %f", &s.reg_no, s.name, s.dept, &s.semester, &s.marks, s.grade, &s.cgpa);
            add_student(client_sock, s, ip_str, port);
        } else if (strncmp(buffer, "SEARCH", 6) == 0) {
            int reg_no;
            sscanf(buffer + 7, "%d", &reg_no);
            search_student(client_sock, reg_no, ip_str, port);
        } else if (strncmp(buffer, "UPDATE", 6) == 0) {
            Student s;
            sscanf(buffer + 7, "%d %s %s %d %f %s %f", &s.reg_no, s.name, s.dept, &s.semester, &s.marks, s.grade, &s.cgpa);
            update_student(client_sock, s, ip_str, port);
        } else if (strncmp(buffer, "DELETE", 6) == 0) {
            int reg_no;
            sscanf(buffer + 7, "%d", &reg_no);
            delete_student(client_sock, reg_no, ip_str, port);
        } else if (strcmp(buffer, "DISPLAY") == 0) {
            display_all(client_sock, ip_str, port);
        } else if (strcmp(buffer, "TOPPER") == 0) {
            generate_topper(client_sock, ip_str, port);
        } else if (strcmp(buffer, "EXIT") == 0) {
            send(client_sock, "Session terminated.", 19, 0);
            log_transaction(ip_str, port, "Client disconnected");
            break;
        } else {
            send(client_sock, "ERROR: Invalid request.", 23, 0);
            log_transaction(ip_str, port, "Invalid command received");
        }
    }

    close(client_sock);
}

int main() {
    int server_sock, client_sock;
    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_size = sizeof(client_addr);

    server_sock = socket(AF_INET, SOCK_STREAM, 0);
    if (server_sock < 0) {
        perror("Socket creation failed");
        exit(1);
    }

    int opt = 1;
    setsockopt(server_sock, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = INADDR_ANY;

    if (bind(server_sock, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Bind failed");
        close(server_sock);
        exit(1);
    }

    if (listen(server_sock, 5) == 0) {
        printf("Student Management Server running on port %d...\n", PORT);
    } else {
        perror("Listen failed");
        exit(1);
    }

    while (1) {
        client_sock = accept(server_sock, (struct sockaddr *)&client_addr, &addr_size);
        if (client_sock < 0) continue;
        handle_client(client_sock, client_addr);
    }

    close(server_sock);
    return 0;
