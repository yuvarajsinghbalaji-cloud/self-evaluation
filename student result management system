#include <netinet/in.h>
#include <arpa/inet.h>

#define PORT 8080
#define BUFFER_SIZE 2048
#define DB_FILE "students.txt"

typedef struct {
    int reg_no;
    char name[50];
    char dept[20];
    int semester;
    float marks;
    char grade[5];
    float cgpa;
} Student;

// Log operations with timestamp
void log_transaction(const char *ip, int port, const char *action) {
    FILE *fp = fopen("server_log.txt", "a");
    if (!fp) return;

    time_t now = time(NULL);
    char *time_str = ctime(&now);
    time_str[strcspn(time_str, "\n")] = 0;

    fprintf(fp, "[%s] [%s:%d] - %s\n", time_str, ip, port, action);
    fclose(fp);
}

// Add a student record to the file
void add_student(int client_sock, Student s, const char *ip, int port) {
    FILE *fp = fopen(DB_FILE, "a+");
    if (!fp) {
        send(client_sock, "ERROR: Unable to open database file.", 36, 0);
        return;
    }

    // Check if record exists
    Student temp;
    rewind(fp);
    while (fscanf(fp, "%d %s %s %d %f %s %f", &temp.reg_no, temp.name, temp.dept, &temp.semester, &temp.marks, temp.grade, &temp.cgpa) != EOF) {
        if (temp.reg_no == s.reg_no) {
            fclose(fp);
            send(client_sock, "ERROR: Register number already exists.", 38, 0);
            log_transaction(ip, port, "ADD Failed: Duplicate Register Number");
            return;
        }
    }

    fprintf(fp, "%d %s %s %d %.2f %s %.2f\n", s.reg_no, s.name, s.dept, s.semester, s.marks, s.grade, s.cgpa);
    fclose(fp);

    log_transaction(ip, port, "ADD: Record added successfully");
    send(client_sock, "SUCCESS: Student record added successfully.", 42, 0);
}

// Search student by Register Number
void search_student(int client_sock, int reg_no, const char *ip, int port) {
    FILE *fp = fopen(DB_FILE, "r");
    if (!fp) {
        send(client_sock, "ERROR: Database empty or missing.", 33, 0);
        return;
    }

    Student s;
    int found = 0;
    char response[BUFFER_SIZE];

    while (fscanf(fp, "%d %s %s %d %f %s %f", &s.reg_no, s.name, s.dept, &s.semester, &s.marks, s.grade, &s.cgpa) != EOF) {
        if (s.reg_no == reg_no) {
            snprintf(response, sizeof(response),
                     "FOUND\nReg No: %d\nName: %s\nDept: %s\nSemester: %d\nMarks: %.2f\nGrade: %s\nCGPA: %.2f",
                     s.reg_no, s.name, s.dept, s.semester, s.marks, s.grade, s.cgpa);
            found = 1;
            break;
        }
    }
    fclose(fp);

    if (found) {
        send(client_sock, response, strlen(response), 0);
        log_transaction(ip, port, "SEARCH: Record found");
    } else {
        send(client_sock, "ERROR: Student record not found.", 32, 0);
        log_transaction(ip, port, "SEARCH Failed: Record not found");
    }
}

// Update student record
void update_student(int client_sock, Student updated, const char *ip, int port) {
    FILE *fp = fopen(DB_FILE, "r");
    FILE *temp_fp = fopen("temp.txt", "w");

    if (!fp || !temp_fp) {
        send(client_sock, "ERROR: Database error during update.", 36, 0);
        if (fp) fclose(fp);
        if (temp_fp) fclose(temp_fp);
        return;
    }

    Student s;
    int found = 0;

    while (fscanf(fp, "%d %s %s %d %f %s %f", &s.reg_no, s.name, s.dept, &s.semester, &s.marks, s.grade, &s.cgpa) != EOF) {
        if (s.reg_no == updated.reg_no) {
            fprintf(temp_fp, "%d %s %s %d %.2f %s %.2f\n", updated.reg_no, updated.name, updated.dept, updated.semester, updated.marks, updated.grade, updated.cgpa);
            found = 1;
        } else {
            fprintf(temp_fp, "%d %s %s %d %.2f %s %.2f\n", s.reg_no, s.name, s.dept, s.semester, s.marks, s.grade, s.cgpa);
        }
    }

    fclose(fp);
    fclose(temp_fp);

    remove(DB_FILE);
    rename("temp.txt", DB_FILE);

    if (found) {
        send(client_sock, "SUCCESS: Student record updated successfully.", 44, 0);
        log_transaction(ip, port, "UPDATE: Record updated");
    } else {
        send(client_sock, "ERROR: Student record not found.", 32, 0);
        log_transaction(ip, port, "UPDATE Failed: Record not found");
    }
}

