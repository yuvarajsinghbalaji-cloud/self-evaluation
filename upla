#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 8080
#define BUFFER_SIZE 1024

int main() {
    int client_sock;
    struct sockaddr_in server_addr;
    char buffer[BUFFER_SIZE];
    char username[50], password[50];

    client_sock = socket(AF_INET, SOCK_STREAM, 0);
    if (client_sock < 0) {
        perror("Socket creation error");
        exit(1);
    }

    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = inet_addr("127.0.0.1");

    if (connect(client_sock, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Connection failed");
        exit(1);
    }

    // Authentication
    printf("--- Login ---\n");
    printf("Username: ");
    scanf("%s", username);
    printf("Password: ");
    scanf("%s", password);

    snprintf(buffer, sizeof(buffer), "%s %s", username, password);
    send(client_sock, buffer, strlen(buffer), 0);

    memset(buffer, 0, BUFFER_SIZE);
    recv(client_sock, buffer, BUFFER_SIZE, 0);

    if (strcmp(buffer, "AUTH_SUCCESS") != 0) {
        printf("Authentication failed! Closing connection.\n");
        close(client_sock);
        return 0;
    }

    printf("\nLogged in successfully!\n");

    int choice;
    while (1) {
        printf("\n========== Menu ==========\n");
        printf("1. Upload File\n");
        printf("2. Download File\n");
        printf("3. Get Server Date & Time\n");
        printf("4. Get Server System Info\n");
        printf("5. Terminate Session\n");
        printf("Enter choice (1-5): ");
        scanf("%d", &choice);

        if (choice == 1) {
            char filename[256];
            printf("Enter filename to upload: ");
            scanf("%s", filename);

            FILE *fp = fopen(filename, "rb");
            if (!fp) {
                printf("File open error!\n");
                continue;
            }

            snprintf(buffer, BUFFER_SIZE, "UPLOAD %s", filename);
            send(client_sock, buffer, strlen(buffer), 0);

            memset(buffer, 0, BUFFER_SIZE);
            recv(client_sock, buffer, BUFFER_SIZE, 0); // Wait for READY signal

            if (strncmp(buffer, "READY", 5) == 0) {
                memset(buffer, 0, BUFFER_SIZE);
                int bytes_read = fread(buffer, 1, BUFFER_SIZE, fp);
                send(client_sock, buffer, bytes_read, 0);
                
                memset(buffer, 0, BUFFER_SIZE);
                recv(client_sock, buffer, BUFFER_SIZE, 0);
                printf("Server Response: %s\n", buffer);
            }
            fclose(fp);

        } else if (choice == 2) {
            char filename[256];
            printf("Enter filename to download: ");
            scanf("%s", filename);

            snprintf(buffer, BUFFER_SIZE, "DOWNLOAD %s", filename);
            send(client_sock, buffer, strlen(buffer), 0);

            memset(buffer, 0, BUFFER_SIZE);
            int bytes_received = recv(client_sock, buffer, BUFFER_SIZE - 1, 0);
            buffer[bytes_received] = '\0';

            if (strncmp(buffer, "ERROR", 5) == 0) {
                printf("Server Error: %s\n", buffer);
            } else {
                FILE *fp = fopen(filename, "wb");
                fwrite(buffer, 1, bytes_received, fp);
                fclose(fp);
                printf("File downloaded successfully as '%s'.\n", filename);
            }

        } else if (choice == 3) {
            strcpy(buffer, "DATETIME");
            send(client_sock, buffer, strlen(buffer), 0);

            memset(buffer, 0, BUFFER_SIZE);
            recv(client_sock, buffer, BUFFER_SIZE, 0);
            printf("Server Date & Time: %s", buffer);

        } else if (choice == 4) {
            strcpy(buffer, "SYSINFO");
            send(client_sock, buffer, strlen(buffer), 0);

            memset(buffer, 0, BUFFER_SIZE);
            recv(client_sock, buffer, BUFFER_SIZE, 0);
            printf("Server System Info: %s\n", buffer);

        } else if (choice == 5) {
            strcpy(buffer, "EXIT");
            send(client_sock, buffer, strlen(buffer), 0);
            printf("Terminating connection...\n");
            break;

        } else {
            printf("Invalid option! Try again.\n");
        }
    }

    close(client_sock);
    return 0;
}#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <time.h>
#include <sys/types.h>
#include <sys/socket.h>
#include <sys/utsname.h>
#include <netinet/in.h>
#include <arpa/inet.h>

#define PORT 8080
#define BUFFER_SIZE 1024

// Function to write timestamped activities to log file
void log_activity(const char *ip, int port, const char *activity) {
    FILE *log_fp = fopen("server_log.txt", "a");
    if (log_fp == NULL) return;

    time_t now = time(NULL);
    char *time_str = ctime(&now);
    time_str[strcspn(time_str, "\n")] = 0; // Remove newline

    fprintf(log_fp, "[%s] [%s:%d] - %s\n", time_str, ip, port, activity);
    fclose(log_fp);
}

// Handler for client session
void handle_client(int client_sock, struct sockaddr_in client_addr) {
    char buffer[BUFFER_SIZE];
    char ip_str[INET_ADDRSTRLEN];
    inet_ntop(AF_INET, &(client_addr.sin_addr), ip_str, INET_ADDRSTRLEN);
    int port = ntohs(client_addr.sin_port);

    log_activity(ip_str, port, "Client connected");

    // 1. Authentication
    char username[50], password[50];
    memset(buffer, 0, BUFFER_SIZE);
    
    // Receive Credentials (Format: username password)
    int bytes_read = recv(client_sock, buffer, sizeof(buffer) - 1, 0);
    if (bytes_read <= 0) {
        close(client_sock);
        return;
    }
    sscanf(buffer, "%s %s", username, password);

    // Hardcoded credentials check
    if (strcmp(username, "admin") == 0 && strcmp(password, "pass123") == 0) {
        strcpy(buffer, "AUTH_SUCCESS");
        send(client_sock, buffer, strlen(buffer), 0);
        log_activity(ip_str, port, "Authentication successful");
    } else {
        strcpy(buffer, "AUTH_FAIL");
        send(client_sock, buffer, strlen(buffer), 0);
        log_activity(ip_str, port, "Authentication failed");
        close(client_sock);
        return;
    }

    // 2. Command Processing Loop
    while (1) {
        memset(buffer, 0, BUFFER_SIZE);
        bytes_read = recv(client_sock, buffer, sizeof(buffer) - 1, 0);
        if (bytes_read <= 0) break;

        buffer[strcspn(buffer, "\n")] = 0;

        // Command 1: Upload File
        if (strncmp(buffer, "UPLOAD ", 7) == 0) {
            char filename[256];
            sscanf(buffer + 7, "%s", filename);
            
            FILE *fp = fopen(filename, "wb");
            if (!fp) {
                send(client_sock, "ERROR: Cannot create file", 25, 0);
                continue;
            }
            send(client_sock, "READY", 5, 0);

            // Read file content size
            memset(buffer, 0, BUFFER_SIZE);
            int file_bytes = recv(client_sock, buffer, BUFFER_SIZE, 0);
            fwrite(buffer, 1, file_bytes, fp);
            fclose(fp);

            log_activity(ip_str, port, "Uploaded file");
            send(client_sock, "File uploaded successfully.", 27, 0);

        // Command 2: Download File
        } else if (strncmp(buffer, "DOWNLOAD ", 9) == 0) {
            char filename[256];
            sscanf(buffer + 9, "%s", filename);

            FILE *fp = fopen(filename, "rb");
            if (!fp) {
                send(client_sock, "ERROR: File not found", 21, 0);
                log_activity(ip_str, port, "Download failed (file not found)");
                continue;
            }

            memset(buffer, 0, BUFFER_SIZE);
            int n = fread(buffer, 1, BUFFER_SIZE, fp);
            send(client_sock, buffer, n, 0);
            fclose(fp);

            log_activity(ip_str, port, "Downloaded file");

        // Command 3: Get Date & Time
        } else if (strcmp(buffer, "DATETIME") == 0) {
            time_t now = time(NULL);
            char *dt = ctime(&now);
            send(client_sock, dt, strlen(dt), 0);
            log_activity(ip_str, port, "Requested Date & Time");

        // Command 4: System Info
        } else if (strcmp(buffer, "SYSINFO") == 0) {
            struct utsname sys_info;
            uname(&sys_info);
            snprintf(buffer, BUFFER_SIZE, "OS: %s | Node: %s | Release: %s | Arch: %s",
                     sys_info.sysname, sys_info.nodename, sys_info.release, sys_info.machine);
            send(client_sock, buffer, strlen(buffer), 0);
            log_activity(ip_str, port, "Requested System Info");

        // Command 5: Terminate Session
        } else if (strcmp(buffer, "EXIT") == 0) {
            send(client_sock, "Goodbye", 7, 0);
            log_activity(ip_str, port, "Session terminated by client");
            break;
        } else {
            send(client_sock, "Invalid choice", 14, 0);
            log_activity(ip_str, port, "Sent invalid command");
        }
    }

    close(client_sock);
}

int main() {
    int server_sock, client_sock;
    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_size = sizeof(client_addr);

    server_sock = socket(AF_INET, SOCK_STREAM, 0);
    if (server_sock < 0) {
        perror("Socket creation failed");
        exit(1);
    }

    int opt = 1;
    setsockopt(server_sock, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = INADDR_ANY;

    if (bind(server_sock, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Bind failed");
        close(server_sock);
        exit(1);
    }

    if (listen(server_sock, 5) == 0) {
        printf("Server listening on port %d...\n", PORT);
    } else {
        perror("Listen failed");
        exit(1);
    }

    while (1) {
        client_sock = accept(server_sock, (struct sockaddr *)&client_addr, &addr_size);
        if (client_sock < 0) continue;

        // Process client
        handle_client(client_sock, client_addr);
    }

    close(server_sock);
    return 0;
}
